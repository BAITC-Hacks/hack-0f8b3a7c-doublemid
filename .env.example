# Copy to .env.local; never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Keep false until you explicitly approve real API calls and their cost.
OPENAI_REQUESTS_ENABLED=false

# Demo accounts are intentionally public. Set false and provide strong passwords for non-demo use.
DEMO_LOGIN_ENABLED=true
ADMIN_PASSWORD=
STUDENT_PASSWORD=
# Optional accounts: team2@sana.demo through team5@sana.demo
TEAM2_PASSWORD=
TEAM3_PASSWORD=
TEAM4_PASSWORD=
TEAM5_PASSWORD=
